# SilverChat 服务器配置（Apache）
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 部分 CGI/FastCGI 主机会剥离 Authorization 请求头，显式透传给 PHP
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  <IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  </IfModule>

  # API 单入口
  RewriteRule ^api/(.*)$ api.php [QSA,L]

  # 已存在的静态文件直接返回
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 其余请求交给前端入口（History API 路由）
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# 敏感目录与文件一律拒绝
RedirectMatch 404 ^/(config|secrets|storage|sql|tools|app)/.*$
RedirectMatch 404 ^/legal/.*\.md$
# 敏感扩展名（PWA manifest 例外，否则 <link rel="manifest"> 永远 404）
RedirectMatch 404 ^/(?!manifest\.json$).*\.(key|log|sql|lock|bak|ini|json)$
RedirectMatch 404 \.sample\.php$
RedirectMatch 404 \.md$

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<FilesMatch "^(install|diag)\.php$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# 静态资源缓存
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
